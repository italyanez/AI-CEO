{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.agentanium.ru"
        }
      ],
      "destination": "https://agentanium.ru/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.agentanium.ru"
        }
      ],
      "destination": "https://agentanium.ru/:path*",
      "permanent": true
    }
  ]
}
